{
  "schema": "takesome.tool.v1",
  "id": "northstar.gui_editor",
  "version": "0.1.0",
  "name": "NorthStar GUI Editor",
  "description": "Standalone Rust GUI/editor host shell for descriptor-driven asset format providers, preview providers, inspector schemas and tool execution diagnostics.",
  "kind": "rust-cli",
  "root": ".",
  "cargo_manifest": "Cargo.toml",
  "install_path": "EngineRepo/NewEngine/editor/northstar-gui-editor/target/debug/northstar-gui-editor.exe",
  "default_args": [
    "doctor",
    "--root",
    "$repo_root/EngineRepo/NewEngine"
  ],
  "validation_args": [
    "doctor",
    "--root",
    "$repo_root/EngineRepo/NewEngine"
  ],
  "formats": [],
  "content_kinds": [
    "editor_host",
    "asset_workspace",
    "format_registry"
  ],
  "capabilities": [
    "editor.asset_workspace.host",
    "editor.tool_discovery.scan",
    "editor.format_registry.read",
    "editor.format_type_registry.read_directory",
    "editor.format_type_registry.register_runtime",
    "editor.preview_surface.compose",
    "editor.inspector_schema.compose",
    "editor.tool_execution.diagnostics"
  ],
  "build_validation": true,
  "safe_for_build": true,
  "maturity": "native-dev"
}
