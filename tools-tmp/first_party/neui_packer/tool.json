{
  "schema": "takesome.tool.v1",
  "id": "northstar.neui_packer",
  "version": "0.3.0",
  "name": "North Star NEUI Packer",
  "description": "XML-first .neui authoring tool: compiles canonical .neui.xml into runtime NEF8 .neui assets and dumps/parses .neui back to readable XMLcentral.",
  "kind": "rust-cli",
  "root": "../../../../../tools/toolsSrc/neui_packer",
  "cargo_manifest": "Cargo.toml",
  "install_path": "tools/exe/northstar-neui-packer.exe",
  "default_args": ["compile", "--root", "$repo_root", "--all"],
  "validation_args": ["validate", "--root", "$repo_root", "--all"],
  "formats": [".neui", ".neui.xml"],
  "content_kinds": ["ui_dictionary", "ui_layout"],
  "format_provider": {
    "provider_id": "northstar.neui_packer",
    "type_ids": ["asset.type.neui.ui_dictionary"],
    "can_read": true,
    "can_write": true,
    "can_inspect": true,
    "can_validate": true,
    "can_diff": true,
    "can_preview": true,
    "can_edit_schema": true,
    "preview_surface": "tree",
    "viewport": "ui_tree",
    "asset_info_fields": ["file_size", "screen_count", "widget_count", "xml_line_count"],
    "editor_schema": "northstar.schema.neui.ui_dictionary.v1"
  },
  "capabilities": [
    "asset.format.neui.read",
    "asset.format.neui.write",
    "asset.format.neui.inspect",
    "asset.format.neui.validate",
    "asset.format.neui.diff",
    "asset.preview.tree",
    "asset.preview.xml_highlight",
    "asset.viewport.ui_tree",
    "asset.info.ui.parameters",
    "asset.editor.ui.edit_schema",
    "assets.ui.neui_pack",
    "assets.ui.neui_xml_dump",
    "assets.import_pipeline.worker",
    "validation.nef8_hash"
  ],
  "build_validation": true,
  "safe_for_build": true,
  "maturity": "native-dev",
  "legacy_replaces": ["*.neui.import.json", "tools/neui_pack.py"]
}
