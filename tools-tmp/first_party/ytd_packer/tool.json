{
  "schema": "takesome.tool.v1",
  "id": "northstar.ytd_packer",
  "version": "0.4.0",
  "name": "North Star YTD Packer",
  "description": "Creates, parses, validates, previews and extracts XML-free NEF8/YTD texture dictionaries backed by binary NETD payloads.",
  "kind": "rust-cli",
  "root": "../../../../../tools/toolsSrc/ytd_packer",
  "cargo_manifest": "Cargo.toml",
  "install_path": "tools/exe/northstar-ytd-packer.exe",
  "default_args": ["inspect", "--input", "$repo_root/EngineRepo/gameAssets/ui/icons/builtin_icons.ytd"],
  "validation_args": ["validate", "--input", "$repo_root/EngineRepo/gameAssets/ui/icons/builtin_icons.ytd"],
  "formats": [".ytd"],
  "content_kinds": ["texture_dictionary"],
  "format_provider": {
    "provider_id": "northstar.ytd_packer",
    "type_ids": ["asset.type.ytd.texture_dictionary"],
    "can_read": true,
    "can_write": true,
    "can_inspect": true,
    "can_validate": true,
    "can_diff": true,
    "can_preview": true,
    "can_edit_schema": true,
    "preview_surface": "texture",
    "viewport": "texture_viewer",
    "asset_info_fields": ["file_size", "texture_count", "width", "height", "pixel_format", "mip_count"],
    "editor_schema": "northstar.schema.ytd.texture_dictionary.v1"
  },
  "capabilities": [
    "asset.format.ytd.read",
    "asset.format.ytd.write",
    "asset.format.ytd.inspect",
    "asset.format.ytd.validate",
    "asset.format.ytd.diff",
    "asset.preview.texture",
    "asset.viewport.texture",
    "asset.info.texture.parameters",
    "asset.editor.texture.edit_schema",
    "assets.textures.ytd_pack",
    "assets.textures.ytd_extract",
    "assets.textures.ytd_inspect",
    "validation.nef8_hash"
  ],
  "build_validation": true,
  "safe_for_build": true,
  "maturity": "native-dev"
}
