{
  "schema": "takesome.tool.v1",
  "id": "northstar.neftd_packer",
  "version": "0.2.0",
  "name": "North Star NEFTD Packer",
  "description": "Builds, inspects, previews and validates .neftd NEF8 font dictionaries.",
  "kind": "rust-cli",
  "root": "../../../../../tools/toolsSrc/neftd_packer",
  "cargo_manifest": "Cargo.toml",
  "install_path": "tools/exe/northstar-neftd-packer.exe",
  "default_args": ["--help"],
  "validation_args": ["--help"],
  "formats": [".neftd"],
  "content_kinds": ["font_dictionary"],
  "format_provider": {
    "provider_id": "northstar.neftd_packer",
    "type_ids": ["asset.type.neftd.font_dictionary"],
    "can_read": true,
    "can_write": true,
    "can_inspect": true,
    "can_validate": true,
    "can_diff": true,
    "can_preview": true,
    "can_edit_schema": true,
    "preview_surface": "tree",
    "viewport": "font_dictionary_tree",
    "asset_info_fields": ["file_size", "font_count", "glyph_count", "atlas_count"],
    "editor_schema": "northstar.schema.neftd.font_dictionary.v1"
  },
  "capabilities": [
    "asset.format.neftd.read",
    "asset.format.neftd.write",
    "asset.format.neftd.inspect",
    "asset.format.neftd.validate",
    "asset.format.neftd.diff",
    "asset.preview.tree",
    "asset.viewport.font_tree",
    "asset.info.font.parameters",
    "asset.editor.font.edit_schema",
    "assets.fonts.neftd_pack",
    "assets.fonts.neftd_inspect",
    "validation.nef8_hash"
  ],
  "build_validation": true,
  "safe_for_build": true,
  "maturity": "native-dev"
}
