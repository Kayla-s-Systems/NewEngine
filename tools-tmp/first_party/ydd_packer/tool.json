{
  "schema": "takesome.tool.v1",
  "id": "northstar.ydd_packer",
  "version": "0.2.0",
  "name": "North Star YDD Packer",
  "description": "Builds, inspects, previews and validates .ydd as a resident NEF8/ListFile drawable dictionary with model entries.",
  "kind": "rust-cli",
  "root": "../../../../../tools/toolsSrc/ydd_packer",
  "cargo_manifest": "Cargo.toml",
  "install_path": "tools/exe/northstar-ydd-packer.exe",
  "default_args": ["--help"],
  "validation_args": ["--help"],
  "formats": [".ydd"],
  "content_kinds": ["drawable_dictionary"],
  "format_provider": {
    "provider_id": "northstar.ydd_packer",
    "type_ids": ["asset.type.ydd.drawable_dictionary"],
    "can_read": true,
    "can_write": true,
    "can_inspect": true,
    "can_validate": true,
    "can_diff": true,
    "can_preview": true,
    "can_edit_schema": true,
    "preview_surface": "model",
    "viewport": "model_viewer_3d",
    "asset_info_fields": ["file_size", "drawable_count", "mesh_count", "material_count", "bounds", "lod_count"],
    "editor_schema": "northstar.schema.ydd.drawable_dictionary.v1"
  },
  "capabilities": [
    "asset.format.ydd.read",
    "asset.format.ydd.write",
    "asset.format.ydd.inspect",
    "asset.format.ydd.validate",
    "asset.format.ydd.diff",
    "asset.preview.model",
    "asset.viewport.model_3d",
    "asset.info.model.parameters",
    "asset.editor.model.edit_schema",
    "assets.listfile.nef8",
    "assets.drawable_dictionary.ydd",
    "model.import.obj",
    "model.import.gltf",
    "model.import.glb",
    "model.import.fbx.placeholder",
    "validation.nef8_hash"
  ],
  "commands": ["pack", "inspect", "list", "validate", "dump-body"],
  "build_validation": true,
  "safe_for_build": true,
  "maturity": "native-dev"
}
