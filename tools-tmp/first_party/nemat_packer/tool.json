{
  "schema": "takesome.tool.v1",
  "id": "northstar.nemat_packer",
  "version": "0.2.0",
  "name": "North Star NEMAT Packer",
  "description": "Builds, inspects, previews, validates and dumps XMLtype .nemat material libraries and material graph data.",
  "kind": "rust-cli",
  "root": "../../../../../tools/toolsSrc/nemat_packer",
  "cargo_manifest": "Cargo.toml",
  "install_path": "tools/exe/northstar-nemat-packer.exe",
  "default_args": ["--help"],
  "validation_args": ["--help"],
  "formats": [".nemat", ".nemat.xml"],
  "content_kinds": ["material_library", "material_graph"],
  "format_provider": {
    "provider_id": "northstar.nemat_packer",
    "type_ids": ["asset.type.nemat.material_library"],
    "can_read": true,
    "can_write": true,
    "can_inspect": true,
    "can_validate": true,
    "can_diff": true,
    "can_preview": true,
    "can_edit_schema": true,
    "preview_surface": "material",
    "viewport": "material_preview",
    "asset_info_fields": ["file_size", "material_count", "shader_count", "texture_slot_count", "xml_line_count"],
    "editor_schema": "northstar.schema.nemat.material_library.v1"
  },
  "capabilities": [
    "asset.format.nemat.read",
    "asset.format.nemat.write",
    "asset.format.nemat.inspect",
    "asset.format.nemat.validate",
    "asset.format.nemat.diff",
    "asset.preview.material",
    "asset.preview.xml_highlight",
    "asset.viewport.material_preview",
    "asset.info.material.parameters",
    "asset.editor.material.edit_schema",
    "assets.materials.nemat_pack",
    "assets.materials.nemat_xml_dump",
    "assets.materials.nemat_inspect",
    "validation.nef8_hash"
  ],
  "build_validation": true,
  "safe_for_build": true,
  "maturity": "native-dev"
}
