{
  "schema": "northstar.assets.importer_descriptors.v1",
  "importers": [
    {
      "importer_id": "northstar.importer.blender_map.v1",
      "label": "Blender discrete map importer",
      "source_extensions": [
        "blend"
      ],
      "source_content_kinds": [
        "source.blender.map"
      ],
      "runtime_outputs": [
        ".ymap@map",
        ".ymap@cell/x/z",
        ".ytyp@map_static_mesh",
        ".ydd@drawable"
      ],
      "owner_gateway": "engine.assets.maps",
      "cache_key_inputs": [
        "source_path",
        "source_content_hash",
        "importer_id",
        "importer_version",
        "settings_hash",
        "target_platform"
      ],
      "deterministic": true,
      "version": "1"
    },
    {
      "importer_id": "northstar.importer.ytyp_xml.v1",
      "label": "YTYP XML authoring importer",
      "source_extensions": [
        "xml",
        "ytyp.xml"
      ],
      "source_content_kinds": [
        "source.ytyp.xml"
      ],
      "runtime_outputs": [
        ".ytyp@archetype_dictionary"
      ],
      "owner_gateway": "engine.assets.definitions",
      "cache_key_inputs": [
        "source_path",
        "source_content_hash",
        "importer_id",
        "importer_version",
        "settings_hash",
        "target_platform"
      ],
      "deterministic": true,
      "version": "1"
    },
    {
      "importer_id": "northstar.importer.neui.v1",
      "label": "NEUI import descriptor compiler",
      "source_extensions": [
        "neui.import.json"
      ],
      "source_content_kinds": [
        "source.neui.import_descriptor"
      ],
      "runtime_outputs": [
        ".neui@ui_library"
      ],
      "owner_gateway": "engine.ui",
      "cache_key_inputs": [
        "source_path",
        "source_content_hash",
        "importer_id",
        "importer_version",
        "settings_hash",
        "target_platform"
      ],
      "deterministic": true,
      "version": "1"
    },
    {
      "importer_id": "northstar.importer.yft_font.v1",
      "version": "1",
      "label": "YFT font dictionary importer",
      "source_extensions": [
        "yft.import.json"
      ],
      "source_content_kinds": [
        "source.yft.import_descriptor"
      ],
      "runtime_outputs": [
        ".yft@font_dictionary"
      ],
      "owner_gateway": "engine.ui.text",
      "cache_key_inputs": [
        "source_path",
        "source_content_hash",
        "importer_id",
        "importer_version",
        "settings_hash",
        "target_platform"
      ],
      "deterministic": true
    },
    {
      "importer_id": "northstar.importer.speedtree_srt.v1",
      "version": "1",
      "label": "SpeedTree SRT foliage importer adapter",
      "source_extensions": [
        "srt"
      ],
      "source_content_kinds": [
        "source.foliage.speedtree_srt"
      ],
      "runtime_outputs": [
        ".nefoliage@foliage_runtime",
        ".ydd@drawable_lods",
        ".nemat@material_library",
        ".ytd@texture_dictionary"
      ],
      "owner_gateway": "engine.assets.models",
      "required_capability": "assets.models.foliage.srt_importer",
      "cache_key_inputs": [
        "source_path",
        "source_content_hash",
        "importer_id",
        "importer_version",
        "settings_hash",
        "target_platform"
      ],
      "deterministic": true
    },
    {
      "importer_id": "northstar.importer.speedtree_spm.v1",
      "version": "1",
      "label": "SpeedTree Modeler SPM foliage importer adapter",
      "source_extensions": [
        "spm"
      ],
      "source_content_kinds": [
        "source.foliage.speedtree_spm"
      ],
      "runtime_outputs": [
        ".nefoliage@foliage_runtime",
        ".ydd@drawable_lods",
        ".nemat@material_library",
        ".ytd@texture_dictionary"
      ],
      "owner_gateway": "engine.assets.models",
      "required_capability": "assets.models.foliage.spm_importer",
      "cache_key_inputs": [
        "source_path",
        "source_content_hash",
        "importer_id",
        "importer_version",
        "settings_hash",
        "target_platform"
      ],
      "deterministic": true
    }
  ]
}
