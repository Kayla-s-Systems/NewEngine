{
  "window": {
    "title": "NewEngine Editor",
    "icon": "ui/engine.ico",
    "size": [
      1600,
      900
    ],
    "placement": {
      "type": "centered",
      "offset": [
        0,
        -24
      ]
    }
  },
  "ui": {
    "backend": "egui"
  },
  "engine": {
    "modules_dir": "../../engineModules"
  },
  "render": {
    "backend": "vulkan_ash",
    "clear_color": [
      0.0,
      0.0,
      0.0,
      0.0
    ],
    "debug_text": "NewEngine | Vulkan"
  },
  "plugins": {
    "newengine.logging": {
      "level": "debug",
      "style": "auto",
      "colors": true,
      "file": "logs/editor.log",
      "tee": true,
      "include": {
        "module_path": true,
        "target": true,
        "file": true,
        "line": false
      },
      "timestamp": "millis",
      "indent": 2,
      "dedup": {
        "window_ms": 250,
        "capacity": 4096
      }
    },
    "newengine.assets": {
      "assets_root": "assets",
      "importers_dir": "importers",
      "filesystem": true,
      "mount_paks": true,
      "pump_steps": 16
    }
  }
}