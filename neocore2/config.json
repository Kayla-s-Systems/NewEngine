{
  "window": {
    "title": "NewEngine Editor",
    "icon": "ui/engine.ico",
    "size": [
      1600,
      900
    ],
    "placement": {
      "type": "centered",
      "offset": [
        0,
        -24
      ]
    }
  },
  "ui": {
    "backend": "egui"
  },
  "engine": {
    "modules_dir": "../../plugins"
  },
  "render": {
    "backend": "vulkan_ash",
    "clear_color": [
      0.0,
      0.0,
      0.0,
      0.0
    ],
    "debug_text": "NewEngine | Vulkan"
  },
  "plugins": {
    "newengine.logging": {
      "level": "debug",
      "file": "cache/logs/editor.log",
      "include": {
        "file": true
      },
      "dedup": {
        "window_ms": 250,
        "capacity": 4096
      }
    },
    "newengine.assets": {
      "filesystem": true,
      "mount_paks": true,
      "pump_steps": 16,
      "pak_scan": {
        "recursive": true,
        "max_depth": 64,
        "follow_symlinks": false,
        "extensions": [
          "nepak",
          "pak"
        ],
        "rescan_interval_ms": 0
      },
      "layers": [
        {
          "type": "dir",
          "priority": 100,
          "path": "assets/",
          "mount": ""
        },
        {
          "type": "pak_glob",
          "priority": 60,
          "dir": "content/",
          "pattern": "*",
          "mount": ""
        },
        {
          "type": "pak_glob",
          "priority": 80,
          "dir": "assets/",
          "pattern": "*",
          "mount": ""
        }
      ]
    }
  }
}