{
  "engine": {
    "modules_dir": "plugins",
    "cache_files": "cache",
    "config": "config"
  },
  "plugins": {
    "newengine": {
      "logging": {
        "filter": null,
        "timestamp": "millis",
        "indent": 2,
        "format": {
          "preset": "aaa",
          "time": "time",
          "brackets": true,
          "sep": " | ",
          "level_width": 5
        },
        "sources": {
          "console": {
            "enabled": true,
            "level": "info",
            "target": "stderr",
            "colors": true,
            "style": "auto"
          },
          "file": {
            "enabled": true,
            "level": "debug",
            "path": "logs/log.log",
            "mode": "truncate"
          }
        },
        "include": {
          "module_path": false,
          "target": false,
          "file": false,
          "line": false
        },
        "rolling": {
          "max_bytes": 33554432,
          "max_files": 5,
          "keep_days": 7
        },
        "dedup": {
          "window_ms": 2000,
          "capacity": 2048
        }
      },
      "platform.winit": {
        "title": "Kayla's Editor",
        "width": 1600,
        "height": 900,
        "placement": {
          "mode": "centered",
          "x": 0,
          "y": -24
        },
        "icon": "ui/engine.ico"
      },
      "engine_runtime": {
        "render": {
          "runtime_profile": {
            "id": "newengine.render.runtime.tier.auto",
            "gpu_safe": false,
            "graphics": {
              "clear_color": [
                0.02,
                0.025,
                0.035,
                1.0
              ],
              "sky": {
                "mode": "native",
                "tick_cycle": "enabled"
              },
              "shadows": "enabled",
              "hdr_scene": "disabled",
              "postfx": "disabled",
              "deferred": "disabled"
            },
            "world": {
              "runtime_terrain_streaming": "enabled",
              "service_physics": "disabled",
              "fallback_ecs_physics": true
            },
            "input": {
              "capture_cursor_on_play": true,
              "force_gameplay_look": true,
              "force_gameplay_actions": true
            },
            "menu": {
              "restore_viewport_pass_on_close": true,
              "restore_gameplay_input_on_close": true,
              "invalidate_shadow_cache_on_close": true
            }
          }
        }
      }
    }
  }
}
