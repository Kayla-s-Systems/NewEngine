{
  "window": {
    "title": "NewEngine Editor",
    "icon": "ui/engine.ico",
    "size": [
      1600,
      900
    ],
    "placement": {
      "type": "centered",
      "offset": [
        0,
        -24
      ]
    }
  },
  "ui": {
    "backend": "egui"
  },
  "engine": {
    "modules_dir": "../../plugins"
  },
  "render": {
    "backend": "vulkan_ash",
    "clear_color": [
      0.0,
      0.0,
      0.0,
      0.0
    ],
    "debug_text": "NewEngine | Vulkan"
  },
  "plugins": {
    "newengine.logging": {
      "level": "debug",
      "style": "auto",
      "colors": true,
      "file": "logs/editor.log",
      "tee": true,
      "include": {
        "module_path": true,
        "target": true,
        "file": true,
        "line": false
      },
      "timestamp": "millis",
      "indent": 2,
      "dedup": {
        "window_ms": 250,
        "capacity": 4096
      }
    },
    "newengine.assets": {
      "filesystem": true,
      "mount_paks": true,
      "pump_steps": 16,
      "pak_scan": {
        "recursive": true,
        "max_depth": 64,
        "follow_symlinks": false,
        "extensions": [
          "nepak",
          "pak"
        ],
        "rescan_interval_ms": 0
      },
      "vfs": {
        "mounts": [
          {
            "type": "overlay",
            "priority": 100
          },
          {
            "type": "disk",
            "path": "assets/",
            "priority": 80
          },
          {
            "type": "pak",
            "path": "content/",
            "priority": 60
          },
          {
            "type": "http",
            "url": "https://cdn.game.com/",
            "priority": 20
          }
        ]
      }
    }
  }
}