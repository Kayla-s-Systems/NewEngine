{
  "window": {
    "title": "NewEngine Editor",
    "icon": "ui/engine.ico",
    "size": [
      1600,
      900
    ],
    "placement": {
      "type": "centered",
      "offset": [
        0,
        -24
      ]
    }
  },
  "ui": {
    "backend": "egui"
  },
  "engine": {
    "modules_dir": "../../plugins"
  },
  "render": {
    "backend": "vulkan_ash",
    "clear_color": [
      0.0,
      0.0,
      0.0,
      0.0
    ],
    "debug_text": "NewEngine | Vulkan"
  },
  "plugins": {
    "newengine.logging": {
      "level": "debug",
      "colors": true,
      "timestamp": "millis",
      "format": {
        "preset": "aaa",
        "time": "time",
        "brackets": true,
        "sep": " │ ",
        "level_width": 5
      },
      "file": "cache/logs/editor.log",
      "tee": true,
      "rolling": {
        "max_bytes": 33554432,
        "max_files": 5,
        "keep_days": 7
      }
    }
  }
}