<?xml version="1.0" encoding="utf-8"?>
<NeUiDictionary schema="newengine.neui.xmlcentral.v1" document_kind="surface">
  <Entries><Entry name="surface" kind="ui_surface" /></Entries>
  <Surface name="apps.aurelia_ui_test.main" kind="showcase" root="showcase.main" theme="assets/ui/themes/northstar_editor.neui@editor_light" />
  <Resources>
    <FontRef name="body" ref="assets/ui/fonts/editor.neftd@tt_lakes_neue_trial_bold" />
    <TextureRef name="logo" ref="assets/ui/icons/builtin_icons.ytd@aurelia_showcase" />
  </Resources>
  <Layout name="showcase.main" title="Aurelia UI Showcase">
    <Panel id="showcase.hero" class="section hero" text="UI Showcase" padding="12" gap="8">
      <Text id="showcase.hero.title" class="title" value="Aurelia UI Showcase" font="assets/ui/fonts/editor.neftd@tt_lakes_neue_trial_bold" />
      <Text id="showcase.hero.subtitle" value="Text, panels, rows, buttons, inputs, sliders, select and list — one DTO tree." />
      <Text id="showcase.hero.note" class="muted" value="Showcase is authored in .neui; Rust only patches runtime state." />
    </Panel>
    <Panel id="showcase.status" class="section" text="Gateway Status" padding="12" gap="6">
      <Grid id="showcase.status.grid" gap="8" min_item_w_px="150">
        <Row id="status.route" class="label-value"><Text id="status.route.label" class="muted" value="Route" /><Text id="status.route.value" class="mono" value="waiting" /></Row>
        <Row id="status.capability" class="label-value"><Text id="status.capability.label" class="muted" value="Capability" /><Text id="status.capability.value" class="mono" value="missing" /></Row>
        <Row id="status.transport" class="label-value"><Text id="status.transport.label" class="muted" value="Transport" /><Text id="status.transport.value" class="mono" value="binary + fallback" /></Row>
        <Row id="status.frame" class="label-value"><Text id="status.frame.label" class="muted" value="Frame" /><Text id="status.frame.value" class="mono" value="0" /></Row>
        <Row id="status.clicks" class="label-value"><Text id="status.clicks.label" class="muted" value="Clicks" /><Text id="status.clicks.value" class="mono" value="0" /></Row>
      </Grid>
    </Panel>
    <Panel id="showcase.layout" class="section" text="Layout" padding="12" gap="8">
      <Row id="showcase.layout.row" class="cards" gap="10" wrap="true">
        <Panel id="layout.card.panel" class="mini-card" padding="8"><Text id="layout.card.panel.title" class="strong" value="Panel" /><Text id="layout.card.panel.body" class="muted" value="Container with title and children" /></Panel>
        <Panel id="layout.card.row" class="mini-card" padding="8"><Text id="layout.card.row.title" class="strong" value="Row" /><Text id="layout.card.row.body" class="muted" value="Horizontal control grouping" /></Panel>
        <Panel id="layout.card.grid" class="mini-card" padding="8"><Text id="layout.card.grid.title" class="strong" value="Grid" /><Text id="layout.card.grid.body" class="muted" value="Compact label/value diagnostics" /></Panel>
      </Row>
      <Separator id="showcase.layout.separator" />
      <Text id="showcase.layout.text" value="Every item above is a provider-neutral node compiled from .neui." />
    </Panel>
    <Panel id="showcase.actions" class="section" text="Actions" padding="12" gap="8">
      <Row id="showcase.actions.row" class="control-row" gap="10" wrap="true">
        <Button id="button.primary" class="primary" label="Primary" action="aurelia_ui_test.click"><Event trigger="click" action="aurelia_ui_test.click" /></Button>
        <Button id="button.secondary" class="secondary" label="Secondary" action="aurelia_ui_test.click"><Event trigger="click" action="aurelia_ui_test.click" /></Button>
        <Button id="button.close" tone="danger" label="Close" action="aurelia_ui_test.quit"><Event trigger="click" action="aurelia_ui_test.quit" /></Button>
      </Row>
      <Text id="showcase.actions.help" value="Buttons dispatch UiEventDispatchFrame back to the test module." />
    </Panel>
    <Panel id="showcase.inputs" class="section" text="Inputs" padding="12" gap="8">
      <Row id="showcase.inputs.row" class="control-row" gap="10" wrap="true">
        <Checkbox id="input.checkbox" class="selected" label="Checkbox" value="true" action="aurelia_ui_test.checkbox" />
        <Toggle id="input.toggle" class="selected" label="Toggle" value="on" action="aurelia_ui_test.toggle" />
        <Input id="input.text" label="Input" value="editable text" action="aurelia_ui_test.input" />
      </Row>
      <Slider id="showcase.slider" label="Slider" action="aurelia_ui_test.slider" min="0" max="1" value="0.5" />
      <Slider id="showcase.progress" class="progressbar" label="Progress style" action="aurelia_ui_test.progress" min="0" max="1" value="0.5" />
    </Panel>
    <Panel id="showcase.selection" class="section" text="Selection" padding="12" gap="8">
      <Row id="showcase.selection.row" class="control-row" gap="10" wrap="true">
        <Select id="select.mode" label="Select" value="Showcase" action="aurelia_ui_test.select" />
        <ScrollBar id="scroll.demo" label="Scroll" value="42%" orientation="horizontal" />
      </Row>
      <List id="showcase.list" text="Component list">
        <Action id="showcase.list.1" label="Surface + Panel" />
        <Action id="showcase.list.2" label="Text + Separator" />
        <Action id="showcase.list.3" label="Button + Action Route" />
        <Action id="showcase.list.4" label="Input + Toggle + Slider" />
      </List>
    </Panel>
    <Panel id="showcase.diagnostics" class="section" text="Conformance" padding="12" gap="6">
      <Column id="showcase.diagnostics.tree">
        <Text id="diag.1" value="✓ app mounts .neui-authored UI tree" />
        <Text id="diag.2" value="✓ engine.ui route resolves active provider" />
        <Text id="diag.3" value="✓ ui.backend capability is explicit" />
        <Text id="diag.4" value="✓ frame transport: runtime patched" />
      </Column>
    </Panel>
  </Layout>
</NeUiDictionary>
