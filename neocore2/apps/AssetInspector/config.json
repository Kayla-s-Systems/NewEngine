{
  "window": {
    "title": "North Star Asset Inspector",
    "size": [
      1600,
      900
    ],
    "placement": {
      "type": "centered"
    }
  },
  "engine": {
    "modules_dir": "ROOT-DIR/pluginsRuntimeAssetInspector",
    "CACHE_FILES": "ROOT-DIR/NewEngine/neocore2/cache/asset-inspector",
    "CONFIG": "ROOT-DIR/NewEngine/neocore2/config/asset-inspector"
  },
  "plugins": {
    "engine.logging.chronicle": {
      "sources": {
        "console": {
          "level": "info"
        },
        "file": {
          "level": "info",
          "mode": "truncate"
        }
      }
    },
    "engine.platform": {
      "window": {
        "title": "North Star Asset Inspector",
        "width": 1600,
        "height": 900
      }
    },
    "engine.render.vulkan": {
      "clear_color": [
        0.93,
        0.95,
        0.98,
        1.0
      ],
      "debug_text": "AssetInspector",
      "mode": "runtime",
      "viewport_pass": true,
      "present": {
        "mode": "mailbox"
      }
    },
    "engine.ui": {
      "surface": "asset.inspector",
      "theme": "asset_inspector.light",
      "required": true,
      "required_capabilities": [
        "ui.backend"
      ],
      "allow_json_fallback": false,
      "document_id": "tools.asset_inspector",
      "asset_root": "gameAssets",
      "source_xml": "ui/src/tools/asset_inspector.neui.xml",
      "compiled_asset": "ui/tools/asset_inspector.neui",
      "mount_surface": "asset.inspector",
      "load_mode": "compiled_neui"
    },
    "engine.runtime": {
      "ui": {
        "screen_profile": {
          "profile": "headless",
          "publish_editor_shell": false
        }
      },
      "render": {
        "ui_only": false,
        "preview_only": true,
        "viewport_pass": true
      }
    },
    "engine.input.compass": {
      "keyboard": true,
      "mouse": true,
      "gamepad": false
    },
    "engine.profiler.starprofiler": {
      "enabled": false
    },
    "engine.ecs.constellation": {
      "enabled": false
    },
    "engine.physics.gravitas": {
      "enabled": false
    }
  }
}
