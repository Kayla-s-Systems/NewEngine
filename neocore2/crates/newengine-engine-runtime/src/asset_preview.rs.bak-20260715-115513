#![forbid(unsafe_op_in_unsafe_fn)]

use std::sync::Arc;

use newengine_assets::{AssetDecodeRequest, AssetServiceClient};
use newengine_assets_api::{
    AssetDocument, AssetFileManifest, ASSET_LIST_FILE_MANIFEST_OUTPUT, LIST_FILE_CONTENT_KIND_YTD,
};
use newengine_material_runtime::MaterialAssetGatewayAdapter;
use newengine_materials::MaterialLoadRequest;
use newengine_model_domain_api::{ModelAssetRequest, ModelMaterialBinding};
use newengine_model_runtime::ModelGatewayClient;
use parking_lot::Mutex;

use crate::{SceneBridge, ViewportBridge};

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum AssetPreviewKind {
    None,
    Texture2d,
    Scene3d,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub struct AssetPreviewSnapshot {
    pub asset_ref: String,
    pub kind: AssetPreviewKind,
    pub ready: bool,
    pub texture_ref: Option<String>,
    pub ui_texture_id: Option<u64>,
    pub width: u32,
    pub height: u32,
    pub diagnostic: Option<String>,
}

impl AssetPreviewSnapshot {
    fn unavailable(asset_ref: impl Into<String>, diagnostic: impl Into<String>) -> Self {
        Self {
            asset_ref: asset_ref.into(),
            kind: AssetPreviewKind::None,
            ready: false,
            texture_ref: None,
            ui_texture_id: None,
            width: 0,
            height: 0,
            diagnostic: Some(diagnostic.into()),
        }
    }
}

/// Single engine API point for visual asset previews.
///
/// It does not decode file formats locally. Texture, model and material data are
/// requested through the same semantic gateways used by game runtime systems.
pub struct AssetPreviewApi {
    assets: AssetServiceClient,
    models: ModelGatewayClient,
    materials: MaterialAssetGatewayAdapter,
    scene: Arc<SceneBridge>,
    viewport: Arc<ViewportBridge>,
    current: Mutex<AssetPreviewSnapshot>,
}

impl AssetPreviewApi {
    pub fn new(scene: Arc<SceneBridge>, viewport: Arc<ViewportBridge>) -> Self {
        let host = newengine_plugin_host::default_host_api();
        let assets = AssetServiceClient::new(host.clone());
        Self {
            models: ModelGatewayClient::new(host.clone()),
            materials: MaterialAssetGatewayAdapter::with_client_and_host(assets.clone(), host),
            assets,
            scene,
            viewport,
            current: Mutex::new(AssetPreviewSnapshot::unavailable("", "no asset selected")),
        }
    }

    pub fn request(
        &self,
        document: &AssetDocument,
        width: u32,
        height: u32,
    ) -> AssetPreviewSnapshot {
        let width = width.max(1);
        let height = height.max(1);
        let result = if self.is_texture(document) {
            self.request_texture(document, width, height)
        } else if self.is_model(document) {
            self.request_model(document, width, height)
        } else if self.is_material(document) {
            self.request_material(document, width, height)
        } else {
            AssetPreviewSnapshot::unavailable(
                document.asset_ref.clone(),
                format!(
                    "asset type '{}' has no visual runtime representation",
                    document.asset_kind
                ),
            )
        };
        *self.current.lock() = result.clone();
        result
    }

    pub fn snapshot(&self) -> AssetPreviewSnapshot {
        let mut snapshot = self.current.lock().clone();
        if snapshot.kind == AssetPreviewKind::Scene3d {
            let texture_id = self.viewport.read_tex_user();
            snapshot.ui_texture_id = (texture_id != 0).then_some(texture_id);
            snapshot.ready = texture_id != 0;
            if snapshot.ready {
                snapshot.diagnostic = None;
            }
        }
        snapshot
    }

    pub fn clear(&self) {
        *self.current.lock() = AssetPreviewSnapshot::unavailable("", "no asset selected");
        self.viewport.publish_extent(0, 0);
    }

    fn request_texture(
        &self,
        document: &AssetDocument,
        _width: u32,
        _height: u32,
    ) -> AssetPreviewSnapshot {
        let texture_ref = if document.asset_ref.contains('@') {
            document.asset_ref.clone()
        } else {
            match self.first_container_entry(&document.asset_ref) {
                Ok(Some(entry_ref)) => entry_ref,
                Ok(None) => {
                    return AssetPreviewSnapshot::unavailable(
                        document.asset_ref.clone(),
                        "texture dictionary contains no entries",
                    )
                }
                Err(error) => {
                    return AssetPreviewSnapshot::unavailable(document.asset_ref.clone(), error)
                }
            }
        };

        match self.assets.textures_entry_rgba8_ref_v1_typed(&texture_ref) {
            Ok(texture) => AssetPreviewSnapshot {
                asset_ref: document.asset_ref.clone(),
                kind: AssetPreviewKind::Texture2d,
                ready: true,
                texture_ref: Some(texture_ref),
                ui_texture_id: None,
                width: texture.width,
                height: texture.height,
                diagnostic: None,
            },
            Err(error) => AssetPreviewSnapshot::unavailable(
                document.asset_ref.clone(),
                format!("engine.assets.textures preview failed: {error}"),
            ),
        }
    }

    fn request_model(
        &self,
        document: &AssetDocument,
        width: u32,
        height: u32,
    ) -> AssetPreviewSnapshot {
        let request = if document.semantic_gateway == "engine.assets.definitions"
            || document.asset_kind.contains("archetype")
        {
            ModelAssetRequest {
                properties_ref: Some(document.asset_ref.clone()),
                ..ModelAssetRequest::default()
            }
        } else {
            ModelAssetRequest::new(document.asset_ref.clone())
        };
        match self
            .models
            .assemble_bundle(&request)
            .and_then(|bundle| self.scene.replace_with_model_preview(bundle))
        {
            Ok(()) => {
                self.viewport.publish_extent(width, height);
                self.viewport.publish_frame_request(true);
                AssetPreviewSnapshot {
                    asset_ref: document.asset_ref.clone(),
                    kind: AssetPreviewKind::Scene3d,
                    ready: false,
                    texture_ref: None,
                    ui_texture_id: None,
                    width,
                    height,
                    diagnostic: None,
                }
            }
            Err(error) => AssetPreviewSnapshot::unavailable(
                document.asset_ref.clone(),
                format!("engine.assets.models preview failed: {error}"),
            ),
        }
    }

    fn request_material(
        &self,
        document: &AssetDocument,
        width: u32,
        height: u32,
    ) -> AssetPreviewSnapshot {
        let request = MaterialLoadRequest {
            logical_path: document.asset_ref.clone(),
            selector: None,
        };
        match self.materials.load_material(&request).and_then(|response| {
            let binding = ModelMaterialBinding {
                slot: response.name.clone(),
                material_ref: Some(document.asset_ref.clone()),
                descriptor: response.descriptor,
                textures: response.textures,
                fallback_color: response.descriptor.base_color,
                resolution_policy: "engine.assets.preview".to_owned(),
            };
            self.scene
                .replace_with_material_preview(binding, &document.asset_ref)
        }) {
            Ok(()) => {
                self.viewport.publish_extent(width, height);
                self.viewport.publish_frame_request(true);
                AssetPreviewSnapshot {
                    asset_ref: document.asset_ref.clone(),
                    kind: AssetPreviewKind::Scene3d,
                    ready: false,
                    texture_ref: None,
                    ui_texture_id: None,
                    width,
                    height,
                    diagnostic: None,
                }
            }
            Err(error) => AssetPreviewSnapshot::unavailable(
                document.asset_ref.clone(),
                format!("engine.assets.materials preview failed: {error}"),
            ),
        }
    }

    fn first_container_entry(&self, logical_path: &str) -> Result<Option<String>, String> {
        let bytes = self.assets.decode_v1(&AssetDecodeRequest {
            logical_path: logical_path.to_owned(),
            output_kind: ASSET_LIST_FILE_MANIFEST_OUTPUT.to_owned(),
            selector: serde_json::Value::Null,
        })?;
        let manifest = serde_json::from_slice::<AssetFileManifest>(&bytes)
            .map_err(|error| format!("invalid asset manifest: {error}"))?;
        Ok(manifest
            .entries
            .into_iter()
            .next()
            .map(|entry| entry.entry_ref))
    }

    fn is_texture(&self, document: &AssetDocument) -> bool {
        document.content_kind == Some(LIST_FILE_CONTENT_KIND_YTD)
            || document.asset_kind.contains("texture")
            || document.semantic_gateway == "engine.assets.textures"
    }

    fn is_model(&self, document: &AssetDocument) -> bool {
        document.semantic_gateway == "engine.model"
            || document.semantic_gateway == "engine.assets.models"
            || document.semantic_gateway == "engine.assets.definitions"
            || document.asset_kind.contains("drawable")
            || document.asset_kind.contains("model")
            || document.asset_kind.contains("archetype")
    }

    fn is_material(&self, document: &AssetDocument) -> bool {
        document.semantic_gateway == "engine.materials"
            || document.semantic_gateway == "engine.assets.materials"
            || document.asset_kind.contains("material")
    }
}
