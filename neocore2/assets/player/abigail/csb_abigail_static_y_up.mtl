# Fixed material library for csb_abigail_static_y_up.obj
# Generated to bind existing DDS texture set to OBJ material names.
# Texture paths are relative to this MTL file.
# Diffuse: map_Kd | Specular/gloss: map_Ks | Normals: norm + map_Bump compatibility.

# accessories
newmtl mat_accs_000_u_high_0
Ka 0.000000 0.000000 0.000000
Kd 1.000000 1.000000 1.000000
Ks 0.180000 0.180000 0.180000
Ns 48.000000
Ni 1.450000
d 1.000000
illum 2
map_Kd textures/accs_diff_000_a_uni.dds
map_Ks textures/accs_spec_000.dds
norm textures/accs_normal_000.dds
map_Bump -bm 1.000000 textures/accs_normal_000.dds
bump -bm 1.000000 textures/accs_normal_000.dds

