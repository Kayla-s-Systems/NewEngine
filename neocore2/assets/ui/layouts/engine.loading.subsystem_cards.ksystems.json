{
  "version": 1,
  "id": "engine.loading.subsystem_card.ksystems.v1",
  "surface_id": "engine.loading",
  "theme": "newengine.dark.gold-magenta",
  "role": "startup-subsystem-card-style",
  "style": "ksystems-industrial-telemetry-card",
  "geometry": {
    "height_px": 136,
    "icon_y_px": 34,
    "title_y_px": 70,
    "state_y_px": 94,
    "detail_y_px": 111,
    "progress_bottom_px": 12,
    "progress_height_px": 6,
    "progress_segments": 18,
    "progress_segment_gap_px": 3
  },
  "text_policy": {
    "title_max_chars": 18,
    "state_max_chars": 12,
    "detail_max_chars": 24,
    "uppercase_state": true,
    "line_model": "title + state + compact detail"
  },
  "visibility": {
    "show_detail": true,
    "show_progress": true
  },
  "rule": "Subsystem cards are provider-owned KSystems presentation specs. Runtime supplies state only; native fallback consumes this spec without owning card design policy.",
  "animation": {
    "pulse_glow": true,
    "glow_radius_px": 5,
    "glow_strength_pct": 38,
    "active_phase": "Running"
  },
  "theme_tokens": {
    "palette_token_set": "newengine.dark.gold-magenta.subsystem-cards",
    "success": "subsystem_card.palette.success",
    "active": "subsystem_card.palette.active",
    "warning": "subsystem_card.palette.warning",
    "error": "subsystem_card.palette.error",
    "waiting": "subsystem_card.palette.waiting",
    "track": "subsystem_card.palette.track",
    "segment_empty": "subsystem_card.palette.segment_empty",
    "glow": "subsystem_card.palette.glow"
  },
  "progress_style": {
    "kind": "segmented-telemetry",
    "segments": 18,
    "segment_gap_px": 3,
    "uses_state_color": true,
    "pulse_active_segment": true
  }
}
