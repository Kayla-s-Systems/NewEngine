{
  "version": 1,
  "id": "engine.error_modal.ksystems",
  "surface_id": "engine.error_modal",
  "theme": "newengine.dark.gold-magenta",
  "modal_system": {
    "id": "newengine.modal.standard.v1",
    "style": "ksystems-launcher",
    "variants": ["success", "warning", "error", "info", "debug"],
    "header_band": true,
    "button_style": "pill",
    "overlay_dimming": true
  },
  "root": {
    "id": "modal-root",
    "kind": "modal",
    "role": "dialog",
    "style": "ksystems.modal.surface",
    "layout": { "anchor": "center", "width": "460-720", "height": "220-320", "padding": 20 },
    "text": null,
    "icon": null,
    "image": null,
    "bindings": [],
    "actions": [],
    "children": [
      {
        "id": "modal-header",
        "kind": "header-bar",
        "role": "titlebar",
        "style": "ksystems.modal.header",
        "layout": { "anchor": "top", "height": 44 },
        "text": "{error_modal.header_label}",
        "icon": "warning-triangle",
        "image": null,
        "bindings": [{ "property": "tone", "source": "state.error_modal.variant" }],
        "actions": [],
        "children": []
      },
      {
        "id": "modal-title",
        "kind": "text",
        "role": "title",
        "style": "ksystems.modal.title",
        "layout": { "anchor": "body", "top": 62 },
        "text": "{error_modal.title}",
        "icon": null,
        "image": null,
        "bindings": [],
        "actions": [],
        "children": []
      }
    ]
  },
  "data_sources": [
    { "id": "overlay", "contract": "ScreenOverlayStatus", "mount": "state" }
  ],
  "actions": [
    { "widget": "primary", "action": "engine.logs.open" },
    { "widget": "secondary", "action": "engine.quit" }
  ]
}
