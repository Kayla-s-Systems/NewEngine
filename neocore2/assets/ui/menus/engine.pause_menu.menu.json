{
  "id": "engine.pause_menu",
  "version": 1,
  "surface_id": "engine.pause_menu",
  "root_page": "root",
  "title": "PAUSE",
  "subtitle": "GAME READY",
  "footer_lines": [
    "ESC / START - Resume or close pause menu",
    "ARROWS / DPAD - Navigate",
    "ENTER / A / CLICK - Confirm",
    "BACKSPACE / B - Back"
  ],
  "pages": [
    {
      "id": "root",
      "title": "Pause Menu",
      "subtitle": "Runtime control surface",
      "back_route": {
        "id": "route.root.back.close",
        "source": "engine.pause_menu.root.back",
        "target": "MenuRuntime",
        "event": "menu.close",
        "transition": { "kind": "close", "reset_selection": true },
        "feedback": { "title": "Resume", "detail": "Returning to gameplay", "severity": "success" },
        "audio": "ui.menu.close"
      },
      "items": [
        {
          "id": "engine.pause_menu.resume",
          "label": "Resume",
          "detail": "Return to the game instantly",
          "tone": "accent",
          "action": {
            "id": "route.root.resume",
            "source": "engine.pause_menu.resume",
            "target": "MenuRuntime",
            "event": "menu.close",
            "transition": { "kind": "close", "reset_selection": true },
            "feedback": { "title": "Resume", "detail": "Returning to gameplay", "severity": "success" },
            "audio": "ui.menu.close"
          }
        },
        {
          "id": "engine.pause_menu.settings",
          "label": "Settings",
          "detail": "Tune runtime, input and presentation",
          "tone": "normal",
          "action": {
            "id": "route.root.settings",
            "source": "engine.pause_menu.settings",
            "target": "MenuRuntime",
            "event": "menu.open_page",
            "transition": { "kind": "open_page", "page": "settings", "reset_selection": true },
            "feedback": { "title": "Settings", "detail": "Runtime options are editable through declarative menu actions", "severity": "info" },
            "audio": "ui.menu.confirm"
          }
        },
        {
          "id": "engine.pause_menu.bindings",
          "label": "Key Bindings",
          "detail": "Remap gameplay and menu actions",
          "tone": "normal",
          "action": {
            "id": "route.root.bindings",
            "source": "engine.pause_menu.bindings",
            "target": "MenuRuntime",
            "event": "menu.open_page",
            "transition": { "kind": "open_page", "page": "bindings", "reset_selection": true },
            "feedback": { "title": "Input bindings", "detail": "Each key, button and action is registered through engine.input.bindings", "severity": "info" },
            "audio": "ui.menu.confirm"
          }
        },
        {
          "id": "engine.pause_menu.exit",
          "label": "Exit",
          "detail": "Close the game and return to desktop",
          "tone": "danger",
          "action": {
            "id": "engine.quit",
            "source": "engine.pause_menu.exit",
            "target": "SystemCommand",
            "event": "engine.shutdown.request",
            "payload": { "origin": "engine.pause_menu.exit" },
            "transition": { "kind": "close", "reset_selection": true },
            "feedback": { "title": "Exit requested", "detail": "Shutting down through the engine lifecycle", "severity": "danger" },
            "audio": "ui.menu.confirm"
          }
        }
      ]
    },
    {
      "id": "settings",
      "title": "Settings",
      "subtitle": "Runtime options",
      "parent_page": "root",
      "back_route": {
        "id": "route.settings.back",
        "source": "engine.pause_menu.settings.back",
        "target": "MenuRuntime",
        "event": "menu.back",
        "transition": { "kind": "open_page", "page": "root", "reset_selection": false },
        "feedback": { "title": "Pause menu", "detail": "Returned to the main pause page", "severity": "info" },
        "audio": "ui.menu.back"
      },
      "items": [
        {
          "id": "engine.pause_menu.settings.device_preference",
          "label": "Input Device",
          "detail": "Choose how semantic input actions are resolved",
          "tone": "accent",
          "emphasized": true,
          "dynamic_value": "input.device_preference",
          "action": {
            "id": "route.settings.device.next",
            "source": "engine.pause_menu.settings.device_preference",
            "target": "InputBindings",
            "event": "engine.input.device_preference.next",
            "feedback": { "title": "Input device", "detail": "Preference changed", "severity": "success" },
            "audio": "ui.menu.navigate"
          },
          "nav_left": {
            "id": "route.settings.device.previous",
            "source": "engine.pause_menu.settings.device_preference.left",
            "target": "InputBindings",
            "event": "engine.input.device_preference.previous",
            "feedback": { "title": "Input device", "detail": "Preference changed", "severity": "success" },
            "audio": "ui.menu.navigate"
          },
          "nav_right": {
            "id": "route.settings.device.next.horizontal",
            "source": "engine.pause_menu.settings.device_preference.right",
            "target": "InputBindings",
            "event": "engine.input.device_preference.next",
            "feedback": { "title": "Input device", "detail": "Preference changed", "severity": "success" },
            "audio": "ui.menu.navigate"
          }
        },
        {
          "id": "engine.pause_menu.settings.reset_bindings",
          "label": "Reset Bindings",
          "detail": "Restore the default gameplay binding profile",
          "tone": "normal",
          "action": {
            "id": "route.settings.reset_bindings",
            "source": "engine.pause_menu.settings.reset_bindings",
            "target": "InputBindings",
            "event": "engine.input.bindings.reset",
            "feedback": { "title": "Bindings reset", "detail": "Default keyboard, mouse and gamepad layout restored", "severity": "success" },
            "audio": "ui.menu.confirm"
          }
        },
        {
          "id": "engine.pause_menu.settings.back",
          "label": "Back",
          "detail": "Return to pause menu",
          "tone": "normal",
          "action": {
            "id": "route.settings.item.back",
            "source": "engine.pause_menu.settings.back",
            "target": "MenuRuntime",
            "event": "menu.back",
            "transition": { "kind": "open_page", "page": "root", "reset_selection": false },
            "feedback": { "title": "Pause menu", "detail": "Returned to the main pause page", "severity": "info" },
            "audio": "ui.menu.back"
          }
        }
      ]
    },
    {
      "id": "bindings",
      "title": "Key Bindings",
      "subtitle": "Gameplay and menu input",
      "parent_page": "root",
      "back_route": {
        "id": "route.bindings.back",
        "source": "engine.pause_menu.bindings.back",
        "target": "MenuRuntime",
        "event": "menu.back",
        "transition": { "kind": "open_page", "page": "root", "reset_selection": false },
        "feedback": { "title": "Pause menu", "detail": "Returned to the main pause page", "severity": "info" },
        "audio": "ui.menu.back"
      },
      "items": [
        {
          "id": "engine.pause_menu.binding.player.move.forward",
          "label": "Move Forward",
          "detail": "Press Enter to rebind this action",
          "dynamic_value": "input.binding_label",
          "action": { "id": "route.binding.player.move.forward", "source": "engine.pause_menu.binding.player.move.forward", "target": "InputBindings", "event": "engine.input.binding.rebind.begin", "payload": { "action_id": "player.move.forward" }, "feedback": { "title": "Listening", "detail": "Press a key, mouse button or gamepad button", "severity": "warning" }, "audio": "ui.menu.rebind" }
        },
        {
          "id": "engine.pause_menu.binding.player.move.back",
          "label": "Move Back",
          "detail": "Press Enter to rebind this action",
          "dynamic_value": "input.binding_label",
          "action": { "id": "route.binding.player.move.back", "source": "engine.pause_menu.binding.player.move.back", "target": "InputBindings", "event": "engine.input.binding.rebind.begin", "payload": { "action_id": "player.move.back" }, "feedback": { "title": "Listening", "detail": "Press a key, mouse button or gamepad button", "severity": "warning" }, "audio": "ui.menu.rebind" }
        },
        {
          "id": "engine.pause_menu.binding.player.move.left",
          "label": "Move Left",
          "detail": "Press Enter to rebind this action",
          "dynamic_value": "input.binding_label",
          "action": { "id": "route.binding.player.move.left", "source": "engine.pause_menu.binding.player.move.left", "target": "InputBindings", "event": "engine.input.binding.rebind.begin", "payload": { "action_id": "player.move.left" }, "feedback": { "title": "Listening", "detail": "Press a key, mouse button or gamepad button", "severity": "warning" }, "audio": "ui.menu.rebind" }
        },
        {
          "id": "engine.pause_menu.binding.player.move.right",
          "label": "Move Right",
          "detail": "Press Enter to rebind this action",
          "dynamic_value": "input.binding_label",
          "action": { "id": "route.binding.player.move.right", "source": "engine.pause_menu.binding.player.move.right", "target": "InputBindings", "event": "engine.input.binding.rebind.begin", "payload": { "action_id": "player.move.right" }, "feedback": { "title": "Listening", "detail": "Press a key, mouse button or gamepad button", "severity": "warning" }, "audio": "ui.menu.rebind" }
        },
        {
          "id": "engine.pause_menu.binding.player.sprint",
          "label": "Sprint",
          "detail": "Press Enter to rebind this action",
          "dynamic_value": "input.binding_label",
          "action": { "id": "route.binding.player.sprint", "source": "engine.pause_menu.binding.player.sprint", "target": "InputBindings", "event": "engine.input.binding.rebind.begin", "payload": { "action_id": "player.sprint" }, "feedback": { "title": "Listening", "detail": "Press a key, mouse button or gamepad button", "severity": "warning" }, "audio": "ui.menu.rebind" }
        },
        {
          "id": "engine.pause_menu.binding.camera.view.next",
          "label": "Cycle Camera",
          "detail": "Press Enter to rebind this action",
          "dynamic_value": "input.binding_label",
          "action": { "id": "route.binding.camera.view.next", "source": "engine.pause_menu.binding.camera.view.next", "target": "InputBindings", "event": "engine.input.binding.rebind.begin", "payload": { "action_id": "camera.view.next" }, "feedback": { "title": "Listening", "detail": "Press a key, mouse button or gamepad button", "severity": "warning" }, "audio": "ui.menu.rebind" }
        },
        {
          "id": "engine.pause_menu.binding.camera.view.first_person",
          "label": "First Person",
          "detail": "Press Enter to rebind this action",
          "dynamic_value": "input.binding_label",
          "action": { "id": "route.binding.camera.view.first_person", "source": "engine.pause_menu.binding.camera.view.first_person", "target": "InputBindings", "event": "engine.input.binding.rebind.begin", "payload": { "action_id": "camera.view.first_person" }, "feedback": { "title": "Listening", "detail": "Press a key, mouse button or gamepad button", "severity": "warning" }, "audio": "ui.menu.rebind" }
        },
        {
          "id": "engine.pause_menu.binding.camera.view.third_person.follow",
          "label": "Third Person Follow",
          "detail": "Press Enter to rebind this action",
          "dynamic_value": "input.binding_label",
          "action": { "id": "route.binding.camera.view.third_person.follow", "source": "engine.pause_menu.binding.camera.view.third_person.follow", "target": "InputBindings", "event": "engine.input.binding.rebind.begin", "payload": { "action_id": "camera.view.third_person.follow" }, "feedback": { "title": "Listening", "detail": "Press a key, mouse button or gamepad button", "severity": "warning" }, "audio": "ui.menu.rebind" }
        },
        {
          "id": "engine.pause_menu.binding.camera.view.third_person.aim",
          "label": "Third Person Aim",
          "detail": "Press Enter to rebind this action",
          "dynamic_value": "input.binding_label",
          "action": { "id": "route.binding.camera.view.third_person.aim", "source": "engine.pause_menu.binding.camera.view.third_person.aim", "target": "InputBindings", "event": "engine.input.binding.rebind.begin", "payload": { "action_id": "camera.view.third_person.aim" }, "feedback": { "title": "Listening", "detail": "Press a key, mouse button or gamepad button", "severity": "warning" }, "audio": "ui.menu.rebind" }
        },
        {
          "id": "engine.pause_menu.binding.engine.menu.toggle_pause",
          "label": "Pause Menu",
          "detail": "Press Enter to rebind this action",
          "dynamic_value": "input.binding_label",
          "action": { "id": "route.binding.engine.menu.toggle_pause", "source": "engine.pause_menu.binding.engine.menu.toggle_pause", "target": "InputBindings", "event": "engine.input.binding.rebind.begin", "payload": { "action_id": "engine.menu.toggle_pause" }, "feedback": { "title": "Listening", "detail": "Press a key, mouse button or gamepad button", "severity": "warning" }, "audio": "ui.menu.rebind" }
        },
        {
          "id": "engine.pause_menu.bindings.back",
          "label": "Back",
          "detail": "Return to pause menu",
          "tone": "accent",
          "action": {
            "id": "route.bindings.item.back",
            "source": "engine.pause_menu.bindings.back",
            "target": "MenuRuntime",
            "event": "menu.back",
            "transition": { "kind": "open_page", "page": "root", "reset_selection": false },
            "feedback": { "title": "Pause menu", "detail": "Returned to the main pause page", "severity": "info" },
            "audio": "ui.menu.back"
          }
        }
      ]
    }
  ]
}
