<ui visuals="dark" density="compact" font_size="14">
    <topbar>
        <label text="$app.name"/>
        <spacer/>

        <button id="frame_all" text="Frame All" on_click="frame_all"/>
        <button id="toggle_grid" text="Grid" on_click="toggle_grid"/>
        <button id="toggle_model" text="Model" on_click="toggle_model"/>
        <spacer/>

        <textbox id="model_path" bind="model_path" hint="models/fox.obj" on_submit="load_model"/>
        <button id="load_model" text="Load" on_click="load_model"/>

        <spacer/>
        <button id="quit" text="Quit" on_click="quit"/>
    </topbar>
</ui>
