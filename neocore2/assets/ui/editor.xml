<ui theme="dark" scale="1.0" density="compact" font_size="14">
    <topbar>
        <row>
            <label text="NewEngine Editor"/>
            <spacer/>
            <label text="entities: ${ecs.entity_count}"/>
            <spacer/>
            <flags id="view_flags"/>
        </row>
    </topbar>

    <sidepanel side="left" width="320">
        <column>
            <label text="Hierarchy"/>
            <spacer/>
            <ecs_hierarchy/>
        </column>
    </sidepanel>

    <sidepanel side="right" width="360">
        <column>
            <label text="Inspector"/>
            <spacer/>
            <ecs_inspector/>
            <spacer/>
            <label text="Model"/>
            <textbox id="model_path" bind="model_path" hint="assets/models/demo.obj"/>
            <button id="btn_load_model" text="Load model"/>
        </column>
    </sidepanel>

    <central>
        <viewport/>
    </central>
</ui>
