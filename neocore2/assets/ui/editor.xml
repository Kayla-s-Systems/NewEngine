<ui theme="dark" scale="1.0" density="compact" font_size="14">
    <topbar>
        <row>
            <label text="NewEngine Editor" icon="${tex.app.logo}" icon_size="16"/>
            <spacer/>

            <!-- Gizmo mode -->
            <button id="gizmo_translate" text="" icon="${tex.gizmo.translate}" icon_size="18"
                    on_click="gizmo.translate"/>
            <button id="gizmo_rotate" text="" icon="${tex.gizmo.rotate}" icon_size="18" on_click="gizmo.rotate"/>
            <button id="gizmo_scale" text="" icon="${tex.gizmo.scale}" icon_size="18" on_click="gizmo.scale"/>

            <separator/>

            <button id="scene_new" text="New" icon="${tex.cmd.reset}" icon_size="18" on_click="scene.new"/>
            <button id="pm_toggle" text="Plugins" icon="${tex.cmd.refresh}" icon_size="18"
                    on_click="editor.plugin_manager.toggle"/>
            <button id="console_toggle" text="Console" icon="${tex.cmd.console}" icon_size="18"
                    on_click="editor.console.toggle"/>

            <spacer/>
            <label text="entities: ${ecs.entity_count}"/>
            <spacer/>
            <flags id="view_flags"/>
        </row>
    </topbar>

    <sidepanel side="left" width="320">
        <column>
            <label text="Hierarchy"/>
            <spacer/>
            <ecs_hierarchy/>
        </column>
    </sidepanel>

    <sidepanel side="right" width="360">
        <column>
            <label text="Inspector"/>
            <spacer/>
            <ecs_inspector/>
            <spacer/>
            <label text="Model"/>
            <textbox id="model_path" bind="model_path" hint="assets/models/demo.obj"/>
            <button id="btn_load_model" text="Load model" icon="${tex.cmd.load}" icon_size="16" on_click="model.load"/>
        </column>
    </sidepanel>

    <central>
        <viewport/>
    </central>
</ui>