<NeUiDictionary schema="newengine.neui.dictionary.v1" representation="xmlcentral" owner_scope="game" document_kind="surface">
  <Entries><Entry name="surface" kind="ui_surface" /><Entry name="layout.main" kind="ui_layout" /><Entry name="bindings" kind="ui_binding_graph" /></Entries>
  <Surface name="game.hud" kind="hud" modal="false" z_order="500" root="layout.main" theme="assets/ui/themes/aurelia_dark.neui@theme" bindings="bindings" />
  <Layout name="layout.main" surface="game.hud"><Panel id="hud.root" class="hud-root"><Panel id="hud.health" class="hud-meter"><Bind property="value" source="player.health" /></Panel><Panel id="hud.ammo" class="hud-ammo"><Text id="hud.ammo.text"><Bind property="text" source="player.ammo_label" fallback="--" /></Text></Panel><Panel id="hud.prompt" class="hud-prompt"><Text id="hud.prompt.text"><Bind property="text" source="interaction.prompt" /></Text></Panel></Panel></Layout>
  <BindingGraph name="bindings"><StateSource id="player" source="game.player.hud" contract="PlayerHudSnapshot" update="dirty" /><StateSource id="interaction" source="game.interaction.prompt" contract="InteractionPromptSnapshot" update="event" /><Bind element="hud.health" property="value" source="player.health" /><Bind element="hud.ammo.text" property="text" source="player.ammo_label" /><Bind element="hud.prompt.text" property="text" source="interaction.prompt" /></BindingGraph>
</NeUiDictionary>
