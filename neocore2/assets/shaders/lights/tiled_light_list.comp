#version 450

#include "light_common.glsl"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer LightBuffer {
    NeLightRecord lights[];
} u_lights;

layout(set = 0, binding = 1, std430) readonly buffer TileGridBuffer {
    NeTileRecord tiles[];
} u_tiles;

layout(set = 0, binding = 2, std430) readonly buffer TileLightIndexBuffer {
    uint indices[];
} u_indices;

layout(set = 0, binding = 3, std430) buffer ClusterGridBuffer {
    NeClusterRecord clusters[];
} u_clusters;

void main() {
    uvec2 tile = ne_current_tile();
    if (!ne_valid_tile(tile)) {
        return;
    }

    uint tile_index = ne_tile_index(tile);
    NeTileRecord tile_record = u_tiles.tiles[tile_index];
    uint cluster_base = tile_index * pc.grid.w;

    for (uint z = 0u; z < pc.grid.w; ++z) {
        uint cluster_index = cluster_base + z;
        if (cluster_index >= pc.counts.w) {
            return;
        }
        // First GPU contract: every Z-slice points at the per-tile list.
        // A later pass can refine z min/max from hierarchical depth without
        // changing the LightBuffer/TileGrid/ClusterGrid ABI.
        u_clusters.clusters[cluster_index].offset_count_minmax = uvec4(
            tile_record.offset_count.x,
            tile_record.offset_count.y,
            z,
            max(z, pc.grid.w - 1u)
        );
    }
}
