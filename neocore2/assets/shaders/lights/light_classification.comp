#version 450

#include "light_common.glsl"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer LightBuffer {
    NeLightRecord lights[];
} u_lights;

layout(set = 0, binding = 1, std430) buffer TileGridBuffer {
    NeTileRecord tiles[];
} u_tiles;

layout(set = 0, binding = 2, std430) buffer TileLightIndexBuffer {
    uint indices[];
} u_indices;

layout(set = 0, binding = 3, std430) buffer ClusterGridBuffer {
    NeClusterRecord clusters[];
} u_clusters;

void main() {
    uvec2 tile = ne_current_tile();
    if (!ne_valid_tile(tile)) {
        return;
    }

    uint tile_index = ne_tile_index(tile);
    uint base = tile_index * pc.counts.y;
    uint count = 0u;
    uint shadowed = 0u;

    for (uint light_index = 0u; light_index < pc.counts.x; ++light_index) {
        NeLightRecord light = u_lights.lights[light_index];
        if (!ne_light_intersects_tile(light, tile)) {
            continue;
        }
        if (count < pc.counts.y) {
            u_indices.indices[base + count] = light_index;
            count += 1u;
            shadowed += ne_light_shadowed(light) ? 1u : 0u;
        }
    }

    u_tiles.tiles[tile_index].offset_count = uvec4(base, count, shadowed, 0u);
}
