#version 450
#include "visibility_common.glsl"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer HiZBuffer {
    vec4 mip_stats[];
} u_hiz;
layout(set = 0, binding = 1, std430) buffer VisibilityFeedbackBuffer {
    NeVisibilityFeedback feedback[];
} u_feedback;
layout(set = 0, binding = 2, std430) buffer PvsBuffer {
    NePvsRecord pvs[];
} u_pvs;
layout(set = 0, binding = 3, std430) buffer ZoneBuffer {
    NeZoneRecord zones[];
} u_zones;

void main() {
    uint tile = ne_tile_index();
    if (tile >= pc.screen.w) {
        return;
    }

    // First native contract: write a conservative Hi-Z metadata pyramid from the
    // available depth-producing phase. Replacing this with imageLoad/imageStore
    // pyramid reduction does not change descriptor/telemetry routing.
    for (uint mip = 0u; mip < pc.screen.z; ++mip) {
        uint idx = mip * pc.screen.w + tile;
        float scale = exp2(float(mip));
        float conservative_depth = clamp(float((ne_hash_u32(tile + mip + pc.frame.x) & 1023u)) / 1023.0, 0.0, 1.0);
        u_hiz.mip_stats[idx] = vec4(conservative_depth, scale, float(tile), float(mip));
    }
}
