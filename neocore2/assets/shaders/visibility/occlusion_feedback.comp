#version 450
#include "visibility_common.glsl"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer HiZBuffer {
    vec4 mip_stats[];
} u_hiz;
layout(set = 0, binding = 1, std430) buffer VisibilityFeedbackBuffer {
    NeVisibilityFeedback feedback[];
} u_feedback;
layout(set = 0, binding = 2, std430) buffer PvsBuffer {
    NePvsRecord pvs[];
} u_pvs;
layout(set = 0, binding = 3, std430) buffer ZoneBuffer {
    NeZoneRecord zones[];
} u_zones;

void main() {
    uint tile = ne_tile_index();
    if (tile >= pc.screen.w) {
        return;
    }
    vec4 depth_meta = u_hiz.mip_stats[tile];
    uint confidence = pc.flags.x != 0u ? 1u : 0u;
    uint visible = depth_meta.x < 0.999 ? 1u : 0u;
    uint phase_mask = pc.counts.w;
    u_feedback.feedback[tile].visibility = uvec4(visible, confidence, uint(depth_meta.x * 65535.0), phase_mask);
}
