#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct GrassInstance {
    vec4 pos_scale;
    vec4 normal_seed;
    vec4 color_lod;
    vec4 blade_params;
};

layout(push_constant) uniform GrassBatchPush {
    uint instance_count;
    uint source_patch_count;
    uint lod_bucket;
    uint frame_index;
} pc;

layout(std430, set = 0, binding = 0) writeonly buffer GrassInstancesOut {
    GrassInstance out_instances[];
};

float hash11(float p) {
    return fract(sin(p * 127.1) * 43758.5453123);
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= pc.instance_count) {
        return;
    }
    float fx = float(id % 256u);
    float fy = float(id / 256u);
    float jitter_x = hash11(float(id) + 13.0) - 0.5;
    float jitter_z = hash11(float(id) + 71.0) - 0.5;
    out_instances[id].pos_scale = vec4((fx + jitter_x) * 0.85, 0.0, (fy + jitter_z) * 0.85, mix(0.65, 1.35, hash11(float(id) + 3.0)));
    out_instances[id].normal_seed = vec4(0.0, 1.0, 0.0, hash11(float(id) + 19.0));
    out_instances[id].color_lod = vec4(0.55, 0.78, 0.38, float(pc.lod_bucket));
    out_instances[id].blade_params = vec4(0.035, 0.65, 0.0, 1.0);
}
