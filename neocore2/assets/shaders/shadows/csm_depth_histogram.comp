#version 450
#extension GL_GOOGLE_include_directive : require
#include "csm_shadow_common.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 1) uniform sampler2D u_depth;
layout(std430, set = 0, binding = 2) buffer DepthHistogramBins {
    uint bins[16];
} histogram;

layout(push_constant) uniform HistogramPush {
    vec4 viewport_size_inv_size;
    uint cascade_index;
    uint _pad0;
    uint _pad1;
    uint _pad2;
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(pc.viewport_size_inv_size.xy);
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }
    float d = texelFetch(u_depth, p, 0).r;
    uint bin_index = min(uint(d * 15.0 + 0.5), 15u);
    atomicAdd(histogram.bins[bin_index], 1u);
}
